{
  "name": "@cancionero/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/db/migraciones && cp -R src/db/migraciones dist/db/",
